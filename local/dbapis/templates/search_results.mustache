{{!
    @template local_dbapis/search_results

    Search results list with optional delete button per row.

    Example context (json):
    {
        "results": [
            {
                "id": 1,
                "message": "Sample message",
                "authorname": "John Doe",
                "deletebutton": "<button>...</button>"
            }
        ],
        "continueurl": "/local/dbapis/search.php",
        "continueurltext": "Continue"
    }
}}

<div class="border p-3 my-3">
{{#results}}
    <p>
        {{#deletebutton}}{{{deletebutton}}} {{/deletebutton}}
        {{id}}, {{message}}, {{authorname}}
    </p>
{{/results}}
</div>
<a href="{{continueurl}}" class="btn btn-link">{{continueurltext}}</a>
